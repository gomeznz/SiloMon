# Postgres connection used by both the app and drizzle-kit.
DATABASE_URL=postgres://silomon:silomon@localhost:5432/silomon

# Optional — tuning for the standalone silo-monitoring worker
# (scripts/silo-worker.ts, run via `npm run worker`). Defaults are 10s poll
# interval / 5s Modbus-TCP connect timeout.
# SILO_POLL_INTERVAL_MS=10000
# SILO_CONNECT_TIMEOUT_MS=5000

# Optional — tuning for the Modbus-TCP test simulator (scripts/silo-simulator.ts,
# run via `npm run simulator`). Defaults are port 502 / 5s DB refresh interval.
# SIM_PORT=502
# SIM_REFRESH_INTERVAL_MS=5000

# Optional — name for this site, shown in the /api/report payload and on the
# central dashboard once this site is pushing to one. Defaults to "SiloMon".
# SITE_NAME=Gladvale Yard

# Optional — enables GET /api/report (src/app/api/report/route.ts), a
# read-only JSON export of this site's current silo data for external
# reporting tools. Required to enable the endpoint at all — with it unset,
# /api/report returns 503. Callers must send "Authorization: Bearer <key>".
# REPORTING_API_KEY=

# Optional — how often the worker checks for central-dashboard config and,
# once configured, pushes this site's report. The dashboard URL and API key
# themselves are NOT set here — configure those on the Setup page (Central
# dashboard card) instead, so rotating a key doesn't need a redeploy.
# REPORT_PUSH_INTERVAL_MS=60000
